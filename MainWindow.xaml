                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Opciones Avanzadas y Plan de Energía de Windows -->
                        <Border x:Name="CardPowerPlans" Style="{StaticResource SectionCard}" Margin="0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Actualizar datos" Style="{StaticResource SecondaryBtn}" Padding="12,5" FontSize="11.5" Click="BtnRefreshPower_Click"/>
                                    <TextBlock Text="PLAN DE ENERGÍA DE WINDOWS Y CONFIGURACIÓN AVANZADA" Style="{StaticResource SectionKicker}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock x:Name="TxtDetailPlanHeader" Text="Estado real activo: --" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtDetailGpu" Text="Gráficas detectadas: --" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                <Border Style="{StaticResource SettingRow}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Cambiar plan de energía de Windows" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        <TextBlock Text="Elige manualmente entre los planes de energía disponibles en tu equipo (en equipos sin directiva bloqueada, cada perfil de WinPulse también selecciona el más adecuado)."
                                                   FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                        <DockPanel>
                                            <Button x:Name="BtnApplyPowerPlan" DockPanel.Dock="Right" Content="Cambiar plan" Style="{StaticResource SecondaryBtn}"
                                                    Click="BtnApplyPowerPlan_Click" Margin="10,0,0,0"/>
                                            <ComboBox x:Name="CmbPowerPlans" DisplayMemberPath="Label" MinHeight="32"
                                                      AutomationProperties.Name="Planes de energía de Windows"/>
                                        </DockPanel>
                                        <TextBlock x:Name="TxtPowerPlanRestriction" Visibility="Collapsed" FontSize="11.5"
                                                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="1. Disco duro (Apagar disco tras)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtPwrDisk" Text="--" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="2. Fondo de escritorio" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtPwrBg" Text="--" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="3. Suspender el equipo tras" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtPwrSleep" Text="--" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRow}" Padding="12,9" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="4. PCI Express (Ahorro de energía)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtPwrPcie" Text="--" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="5. Administración del procesador" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtPwrProc" Text="--" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="Modo turbo del procesador" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"/>
                                                <TextBlock x:Name="TxtPwrBoost" Text="--" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="6. Pantalla (Apagar pantalla tras)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtPwrDisplay" Text="--" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="BatteryPowerDetails" Style="{StaticResource SettingRow}" Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="Batería (niveles de aviso)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtPwrBattery" Text="--" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SettingRow}" Padding="12,9" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="Modo de energía de Windows" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock x:Name="TxtPwrOverlay" Text="--" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PESTAÑA 1 -->
            <TabItem Header="FPS, GPU y CPU" Tag="{StaticResource DisplayGlyph}" Style="{StaticResource NavigationTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,8">
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="GRÁFICA Y PANTALLA" Style="{StaticResource SectionKicker}"/>
                                <TextBlock Text="Ajustes de aceleración de GPU, modo juego y latencia de imagen en ventana." Style="{StaticResource SectionSubtitle}"/>

                                <Border x:Name="RowSwGameMode" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwGameMode" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Modo Juego de Windows (Reparto inteligente de núcleos)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Dedica los núcleos más potentes de tu procesador al juego y deja las tareas secundarias en los núcleos de ahorro." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwHags" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwHags" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Aceleración Gráfica por Hardware (HAGS)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Delega parte de la programación de la GPU al hardware cuando el controlador lo admite." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwWindowedOpt" Style="{StaticResource SettingRow}" Margin="0">
                                    <DockPanel>
                                        <CheckBox x:Name="SwWindowedOpt" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Optimización para Juegos en Ventana sin Bordes" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Elimina el retardo de imagen cuando juegas en modo ventana sin bordes en lugar de pantalla completa." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="PROCESADOR Y PRIORIDAD" Style="{StaticResource SectionKicker}"/>
                                <TextBlock Text="Estabilidad de fotogramas, núcleos activos con corriente y prioridad multimedia." Style="{StaticResource SectionSubtitle}"/>

                                <Border x:Name="RowSwHighResTimer" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwHighResTimer" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Temporizador de Alta Precisión (FPS más estables)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Evita tirones repentinos haciendo que Windows responda cada 0,5 milisegundos en juegos." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwCoreParking" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwCoreParking" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Mantener todos los núcleos despiertos (Solo enchufado)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Evita micro-tirones al despertar núcleos dormidos cuando juegas con el cargador puesto." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwMmcss" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwMmcss" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Prioridad Alta para Gráfica y Procesador en Juegos" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Da preferencia al juego frente a otros programas abiertos mientras estás jugando." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwSmartGamePriority" Style="{StaticResource SettingRow}" Margin="0">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox x:Name="SwSmartGamePriority" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                                      Checked="SmartGamePriority_Changed" Unchecked="SmartGamePriority_Changed" Margin="14,0,0,0"
                                                      AutomationProperties.Name="Reparto inteligente de CPU mientras juegas"/>
                                            <StackPanel>
                                                <TextBlock Text="Reparto inteligente de CPU mientras el juego está activo (sin UAC)" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="Sube la prioridad del juego activo (Por encima de lo normal) y limita apps pesadas minimizadas con Modo eficiencia (EcoQoS) hasta que cierres o cambies de ventana."
                                                           FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                <TextBlock x:Name="TxtSmartGamePriorityStatus" Text="Desactivado" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                                           Foreground="{DynamicResource QuietBrush}" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Expander Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0">
                                            <Expander.Header>
                                                <TextBlock Text="Proteger programas en segundo plano (EcoQoS y RAM adaptativa)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            </Expander.Header>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="Un ejecutable por línea (por ejemplo spotify.exe). OBS, Discord, TeamSpeak, Voicemeeter y NVIDIA Broadcast ya están protegidos por defecto."
                                                           FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <TextBox x:Name="TxtExcludedBackgroundApps" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="68" Padding="8,6"/>
                                                <DockPanel Margin="0,8,0,0">
                                                    <Button Content="Guardar exclusiones" DockPanel.Dock="Left" Style="{StaticResource SecondaryBtn}"
                                                            Click="BtnSaveBackgroundExclusions_Click" Margin="0,0,12,0"/>
                                                    <TextBlock x:Name="TxtExcludedBackgroundStatus" VerticalAlignment="Center" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CardDedicatedGpuGames" Style="{StaticResource SectionCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="GRÁFICA DEDICADA POR JUEGO (DGPU)" Style="{StaticResource SectionKicker}"/>
                                <TextBlock Text="Asigna «Alto rendimiento» en Gráficos de Windows (HKCU, sin permiso extra) para evitar que los juegos usen la gráfica integrada." Style="{StaticResource SectionSubtitle}"/>

                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwAutoForceDgpu" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                                  Checked="AutoForceDgpu_Changed" Unchecked="AutoForceDgpu_Changed" Margin="14,0,0,0"
                                                  AutomationProperties.Name="Asignar dGPU automáticamente al detectar juegos"/>
                                        <StackPanel>
                                            <TextBlock Text="Asignar gráfica dedicada automáticamente al detectar juegos" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Cuando el vigilante detecte un juego incluido, lo registra con Alto rendimiento para su próximo inicio."
                                                       FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <DockPanel Margin="0,2,0,12">
                                    <WrapPanel DockPanel.Dock="Left">
                                        <Button Content="Añadir juego (.exe)…" Style="{StaticResource PrimaryBtn}" Click="BtnAddDgpuGame_Click" Margin="0,0,8,0"/>
                                        <Button Content="Actualizar lista" Style="{StaticResource SecondaryBtn}" Click="BtnRefreshDgpuGames_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtDgpuGamesStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                               VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </DockPanel>

                                <TextBlock x:Name="TxtNoDgpuGames" Text="No hay juegos configurados con preferencia dGPU."
                                           Foreground="{DynamicResource QuietBrush}" FontSize="12" Margin="2,2,0,0"/>

                                <ItemsControl x:Name="LstDgpuGames">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#131418" BorderBrush="#26282E" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Quitar" Style="{StaticResource DangerBtn}" Padding="10,5"
                                                            Tag="{Binding ExecutablePath}" Click="BtnRemoveDgpuGame_Click" Margin="12,0,0,0" VerticalAlignment="Center"/>
