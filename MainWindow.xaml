<Window x:Class="WinPulseOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinPulse Pro" Icon="Assets/WinPulse.ico" ShowInTaskbar="True" Height="900" Width="1220" MinHeight="680" MinWidth="860"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" UseLayoutRounding="True" SizeChanged="MainWindow_SizeChanged"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource DisplayFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </Window.Resources>

    <Grid x:Name="MainLayout" Margin="26,20" SizeChanged="MainLayout_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ActivityLogGap" Width="0"/>
            <ColumnDefinition x:Name="ActivityLogColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" LastChildFill="True">
                    <Image x:Name="ImgAppLogo" DockPanel.Dock="Left" Width="30" Height="30" VerticalAlignment="Top" Margin="0,3,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="WinPulse Pro" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                       Margin="0,0,10,3" VerticalAlignment="Center"/>
                            <Border Background="#15171C" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="8,3" Margin="0,1,10,3" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOsBadge" Text="Windows 11" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <Button x:Name="BtnUpdateStatus" Content="Buscar actualización" Style="{StaticResource LinkBtn}"
                                    HorizontalAlignment="Left" MinHeight="24" Padding="10,3" FontSize="11.5"
                                    Margin="0,1,0,3" VerticalAlignment="Center" Click="BtnUpdateStatus_Click"
                                    ToolTip="Comprobar si hay una versión nueva disponible en GitHub"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtHardware" Text="Detectando equipo..." FontSize="12" Foreground="{DynamicResource QuietBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgePower" Background="Transparent" Padding="6,4" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtPowerState" Text="Conectado a la corriente" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                    <Button x:Name="BtnToggleActivityLog" Content="Registro" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                            ToolTip="Abrir registro de actividad" AutomationProperties.Name="Abrir registro de actividad"
                            Click="BtnToggleActivityLog_Click"/>
                    <Button Content="Privacidad" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0" Click="BtnPrivacy_Click"/>
                    <Button Content="Salir" Style="{StaticResource DangerBtn}" Padding="12,7" ToolTip="Cerrar WinPulse Pro por completo. La X lo oculta junto al reloj." Click="BtnExitApp_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Selector de Planes -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" x:Name="CardProfiles" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="14" Padding="18,12" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnProfileJugar" Content="Jugar (Máximo)" Style="{StaticResource ProfileBtn}" Click="BtnJugar_Click" Margin="0,2,8,2"
                                ToolTip="CPU 5–100 %, turbo agresivo, Modo Juego, HAGS, núcleos activos, pausa servicios pesados y activa Mejor rendimiento."/>
                        <Button x:Name="BtnProfileEstudiar" Content="Estudiar / Trabajar" Style="{StaticResource ProfileBtn}" Click="BtnEstudiar_Click" Margin="0,2,8,2"
                                ToolTip="CPU 5–100 %, modo Equilibrado, reanuda servicios pausados, Modo Juego, HAGS, ventana sin bordes, prioridad activa y ajuste TCP."/>
                        <Button x:Name="BtnProfileChill" Content="Estar Chill" Style="{StaticResource ProfileBtn}" Click="BtnChill_Click" Margin="0,2,8,2"
                                ToolTip="CPU máx. 80 % enchufado y 70 % batería, modo Eficiencia energética, bloquea apps en segundo plano y reanuda servicios pausados."/>
                        <Button x:Name="BtnProfileFabrica" Style="{StaticResource ProfileBtn}" Click="BtnReset_Click" Margin="0,2,0,2"
                                AutomationProperties.Name="De fábrica"
                                ToolTip="Restaura los valores predefinidos de Windows (plan Equilibrado, CPU 5–100 %, sin ajustes agresivos ni servicios pausados).">
                            <ContentControl Style="{StaticResource IconLabel}" Content="De fábrica" Tag="{StaticResource HistoryGlyph}"/>
                        </Button>
                    </WrapPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotActiveProfile" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtActiveModeLabel" Text="PLAN ACTIVO:" FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtActiveModeTitle" Text="DETECTANDO..." FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="BtnToggleProfileGuide" Content="¿Qué cambia?" Style="{StaticResource LinkBtn}"
                                    HorizontalAlignment="Left" MinHeight="24" Padding="9,3" FontSize="11.5" Margin="0,1,0,1" VerticalAlignment="Center"
                                    Click="BtnToggleProfileGuide_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtActiveModeDesc" Text="Comprobando equipo..." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <Border x:Name="ProfileGuidePanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="0,12,0,0"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource SettingRow}" Padding="14,12" Margin="0,0,8,0">
                            <StackPanel>
                                <ContentControl Content="Jugar (Máximo)" Tag="{StaticResource GameGlyph}" Style="{StaticResource IconLabel}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="TxtGuideJugar" Text="CPU 5–100 %, turbo agresivo, Modo Juego, HAGS, núcleos activos, prioridad MMCSS/red/USB y pausa servicios pesados." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" Padding="14,12" Margin="4,0,4,0">
                            <StackPanel>
                                <ContentControl Content="Estudiar / Trabajar" Tag="{StaticResource StudyGlyph}" Style="{StaticResource IconLabel}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="TxtGuideEstudiar" Text="CPU 5–100 %, modo Equilibrado, reanuda servicios pausados, mantiene Modo Juego, HAGS, ventana sin bordes, prioridad activa y TCP." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" Padding="14,12" Margin="4,0,4,0">
                            <StackPanel>
                                <ContentControl Content="Estar Chill" Tag="{StaticResource QuietGlyph}" Style="{StaticResource IconLabel}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="TxtGuideChill" Text="Ahorro: máx. CPU 80 % enchufado y 70 % batería, modo Eficiencia energética, bloquea apps en segundo plano y reanuda servicios." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingRow}" Padding="14,12" Margin="8,0,0,0">
                            <StackPanel>
                                <ContentControl Content="De fábrica" Tag="{StaticResource HistoryGlyph}" Style="{StaticResource IconLabel}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="Valores predefinidos de Windows: plan Equilibrado, CPU 5–100 %, sin bloqueo de apps en segundo plano ni ajustes agresivos." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Pestañas -->
        <TabControl x:Name="MainTabs" Grid.Row="2" Style="{StaticResource NavigationTabs}" SelectionChanged="MainTabs_SelectionChanged">
            <!-- PESTAÑA 0: INICIO Y ENERGÍA -->
            <TabItem Header="Inicio y energía" Tag="{StaticResource PowerGlyph}" Style="{StaticResource NavigationTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,8">
                        <!-- Recomendado al entrar: limpieza y RAM -->
                        <Border x:Name="RowMaintenance" Style="{StaticResource SectionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,2,16,2"/>
                                <DockPanel Grid.Column="1" LastChildFill="True">
                                    <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button x:Name="BtnQuickTrimRam" Content="Solo liberar RAM" Style="{StaticResource SecondaryBtn}"
                                                Padding="13,7" Margin="0,2,8,2" Click="BtnPurgeRam_Click"
                                                ToolTip="Libera memoria residente de procesos en segundo plano al instante sin cerrar aplicaciones."/>
                                        <Button x:Name="BtnQuickCleanAndRam" Content="Limpiar y liberar RAM" Style="{StaticResource PrimaryBtn}"
                                                Padding="15,7" Margin="0,2,0,2" Click="BtnMaintenance_Click"
                                                ToolTip="Borra temporales, libera memoria RAM, vacía caché DNS y optimiza el disco SSD."/>
                                    </WrapPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="RECOMENDADO AL ENTRAR" FontFamily="{DynamicResource MonoFont}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="· Libera RAM y limpia basura antes de empezar" FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="TxtQuickCleanupHint"
                                                   Text="Reduce la memoria ocupada por procesos inactivos y borra temporales (%TEMP%, Windows\Temp, D3DSCache y caché NVIDIA/AMD) sin cerrar tus apps."
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- Recomendado para el plan elegido -->
                        <Border x:Name="CardPlanRecommendation" Style="{StaticResource SectionCard}" Padding="20,14" Margin="0,0,0,18">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="BtnApplyPlanRecommendation" DockPanel.Dock="Right" Content="Aplicar recomendados"
                                        Style="{StaticResource SecondaryBtn}" VerticalAlignment="Center" Margin="16,0,0,0"
                                        Click="BtnApplyPlanRecommendation_Click"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPlanRecommendationKicker" Text="RECOMENDADO PARA TU PLAN ELEGIDO"
                                               Style="{StaticResource SectionKicker}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtPlanRecommendationBody"
                                               Text="Analizando los ajustes recomendados para tu plan activo..."
                                               FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Tarjetas de estado en vivo -->
                        <UniformGrid x:Name="DashboardMetrics" Columns="3" Margin="0,0,0,18">
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="14" Padding="18,15" Margin="0,0,7,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Ellipse x:Name="DotLiveTelemetry" DockPanel.Dock="Left" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1.1">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <SineEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock Text="AHORA MISMO" FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtLiveCpu" Text="CPU: -- %" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtLiveRam" Text="RAM: -- / -- GB" FontSize="13" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtLiveGpu" Text="GPU" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtLiveGpuStats" Text="Consultando…" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtLiveProcs" Text="Procesos en vivo: --" FontSize="11" Foreground="{DynamicResource QuietBrush}" Margin="0,3,0,0" TextWrapping="Wrap"
                                               ToolTip="Incluye los procesos de Windows y de las aplicaciones. El recuento cambia con la actividad del equipo."/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="14" Padding="18,15" Margin="7,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="MEDICIÓN DE REFERENCIA" FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtBeforeMain" Text="Sin capturar" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtBeforeSub" Text="Se mide al abrir y antes de cambiar de perfil" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <Button Content="Guardar foto" Style="{StaticResource LinkBtn}" Click="BtnCaptureBefore_Click"
                                            HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="14" Padding="18,15" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtAfterTitle" Text="ESTADO AL ABRIR" FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtAfterMain" Text="Leyendo el plan activo…" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtAfterSub" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="BtnLatestProfileReport" Content="Ver ajustes del último perfil"
                                                Style="{StaticResource LinkBtn}" Margin="0,0,8,4"
                                                IsEnabled="False" Click="BtnShowProfileReport_Click"/>
                                        <Button Content="Estado de los ajustes" Style="{StaticResource LinkBtn}" Margin="0,0,0,4"
                                                Click="BtnShowSettingStatus_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Automatización de Perfiles -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="TxtAutoStatus" DockPanel.Dock="Right" Text="Vigilante activo" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="AUTOMATIZACIÓN DE PERFILES" Style="{StaticResource SectionKicker}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="Cambia de perfil automáticamente al abrir juegos o desconectar el cargador." Style="{StaticResource SectionSubtitle}"/>

                                <Button x:Name="BtnApproveAutomation" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,10"
                                        Style="{StaticResource PrimaryBtn}" Click="BtnApproveAutomation_Click"/>

                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwAutoGame" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed" Margin="14,0,0,0"
                                                  AutomationProperties.Name="Cambio automático al detectar juegos"/>
                                        <StackPanel>
                                            <ContentControl Content="Cambio automático al detectar juegos" Tag="{StaticResource GameGlyph}" Style="{StaticResource IconLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="Detecta el perfil asignado al juego. WinPulse te avisa cuando hace falta autorizar la aplicación o la vuelta al perfil anterior." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="23,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="BatteryAutomationOptions" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwAutoBattery" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed" Margin="14,0,0,0"
                                                  AutomationProperties.Name="Activar Estar Chill al desconectar el cargador"/>
                                        <StackPanel>
                                            <ContentControl Content="Cambio automático a 'Estar Chill' al desconectar el cargador" Tag="{StaticResource BatteryGlyph}" Style="{StaticResource IconLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="Activa Chill en batería. Al reconectar el cargador recupera el perfil anterior; si hay un juego abierto, se aplica la regla de juegos." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="23,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="BatteryGameOptions" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwGameOnBattery" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Permitir perfiles de juego automáticamente en batería" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Si lo activas, el perfil del juego tiene prioridad sobre Chill mientras juegas." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border Style="{StaticResource SettingRow}" Margin="0">
                                    <Expander Foreground="{DynamicResource TextBrush}">
                                        <Expander.Header>
                                            <TextBlock Text="Reglas de detección por ejecutable" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                        </Expander.Header>
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="Escribe un ejecutable por línea, por ejemplo juego.exe. Las exclusiones tienen prioridad." Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,10,0">
                                                    <Label Content="Incluir ejecutables" Target="{Binding ElementName=TxtIncludedGames}" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBox x:Name="TxtIncludedGames" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="78" Padding="8,6"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <Label Content="Excluir ejecutables" Target="{Binding ElementName=TxtExcludedGames}" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBox x:Name="TxtExcludedGames" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="78" Padding="8,6"/>
                                                </StackPanel>
                                            </UniformGrid>
                                            <DockPanel Margin="0,10,0,0">
                                                <Button Content="Guardar reglas" DockPanel.Dock="Left" Style="{StaticResource SecondaryBtn}" Click="BtnSaveGameRules_Click" Margin="0,0,12,0"/>
                                                <TextBlock x:Name="TxtGameRulesStatus" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Perfiles por Juego -->
                        <Border x:Name="RowGameProfiles" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="PERFILES POR JUEGO" Style="{StaticResource SectionKicker}"/>
                                <TextBlock Text="Guarda un plan de energía y ajustes concretos para cada ejecutable. Requiere tener activada la detección de juegos." Style="{StaticResource SectionSubtitle}"/>

                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                                        <Button Content="Nuevo" Style="{StaticResource PrimaryBtn}" Click="BtnNewGameProfile_Click" Margin="0,0,6,0"/>
                                        <Button x:Name="BtnEditGameProfile" Content="Editar" Style="{StaticResource SecondaryBtn}" Click="BtnEditGameProfile_Click" IsEnabled="False" Margin="0,0,6,0"/>
                                        <Button x:Name="BtnDeleteGameProfile" Content="Eliminar" Style="{StaticResource SecondaryBtn}" Click="BtnDeleteGameProfile_Click" IsEnabled="False"/>
                                    </WrapPanel>
                                    <ComboBox x:Name="CmbGameProfiles" DisplayMemberPath="Name" MinHeight="32"
                                              AutomationProperties.Name="Perfiles guardados" SelectionChanged="CmbGameProfiles_SelectionChanged"/>
                                </DockPanel>
                                <TextBlock x:Name="TxtGameProfileExecutables" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <DockPanel Margin="0,10,0,0">
                                    <WrapPanel DockPanel.Dock="Left">
                                        <Button x:Name="BtnExportGameProfiles" Content="Exportar perfiles…" Style="{StaticResource SecondaryBtn}"
                                                Click="BtnExportGameProfiles_Click" IsEnabled="False" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnImportGameProfiles" Content="Importar perfiles…" Style="{StaticResource SecondaryBtn}"
                                                Click="BtnImportGameProfiles_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtGameProfilesStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- Inicio con Windows -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="INICIO DE WINPULSE" Style="{StaticResource SectionKicker}" Margin="0,0,0,10"/>
                                <Border Style="{StaticResource SettingRow}" Margin="0">
                                    <DockPanel>
                                        <CheckBox x:Name="SwStartWithWindows" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="StartWithWindows_Changed" Unchecked="StartWithWindows_Changed" Margin="14,0,0,0"
                                                  AutomationProperties.Name="Iniciar minimizado con Windows"/>
                                        <StackPanel>
