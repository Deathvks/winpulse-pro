                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
                                                            <TextBlock Text="  dGPU" FontFamily="{DynamicResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ExecutablePath}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                                                   Foreground="{DynamicResource QuietBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding ExecutablePath}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PESTAÑA 2 -->
            <TabItem x:Name="TabProcesses" Header="Procesos y RAM" Tag="{StaticResource TasksGlyph}" Style="{StaticResource NavigationTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,8">
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="SEGUNDO PLANO Y PRIORIDAD" Style="{StaticResource SectionKicker}"/>
                                <TextBlock Text="Reduce carga innecesaria de servicios, grabación oculta y apps en segundo plano." Style="{StaticResource SectionSubtitle}"/>

                                <Border x:Name="RowSwSuspendServices" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwSuspendServices" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Pausar Servicios Pesados de Windows mientras juegas" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Pausa temporalmente los servicios compatibles. Al salir de Jugar, WinPulse intenta reanudar los servicios que haya pausado." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwForegroundPrio" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwForegroundPrio" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Dar más potencia a la ventana que estás usando" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Prioriza el programa en pantalla frente a los que tienes minimizados." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwGameDvr" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwGameDvr" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Apagar Grabación Oculta de Pantalla (Game DVR)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Evita que Windows esté grabando vídeo en segundo plano gastando memoria de la gráfica." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwBgApps" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwBgApps" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Bloquear Apps de Windows en Segundo Plano" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Impide que aplicaciones que no estás usando consuman memoria RAM." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwFastUi" Style="{StaticResource SettingRow}">
