                                        <TextBlock x:Name="TxtAdaptiveMemoryStatus" Text="Desactivado" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel x:Name="ProcessUsageSection">
                                <DockPanel Margin="0,0,0,4">
                                    <Button x:Name="BtnMeasureProcesses" DockPanel.Dock="Right" Content="Medir 6 s"
                                            Style="{StaticResource PrimaryBtn}" Click="BtnMeasureProcesses_Click" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="DIAGNÓSTICO DE RECURSOS EN VIVO" Style="{StaticResource SectionKicker}"/>
                                        <TextBlock Text="¿Qué está consumiendo recursos?" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="TxtProcessMeasurement" Text="Mide qué apps usan recursos mientras juegas o trabajas."
                                           Margin="0,4,0,10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <DataGrid x:Name="GridProcessUsage" Visibility="Collapsed" IsReadOnly="True"
                                          AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                                          MaxHeight="265" Margin="0,0,0,10" BorderBrush="{DynamicResource StrokeBrush}"
                                          Background="{DynamicResource PanelBrush}" RowBackground="{DynamicResource PanelBrush}"
                                          AlternatingRowBackground="{DynamicResource RaisedBrush}" Foreground="{DynamicResource TextBrush}"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource StrokeBrush}">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Proceso" Binding="{Binding Name}" Width="2*"/>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="Auto"/>
                                        <DataGridTextColumn Header="CPU media" Binding="{Binding CpuPercent, StringFormat={}{0:0.00} %, TargetNullValue=—}" Width="*"/>
                                        <DataGridTextColumn Header="RAM al final" Binding="{Binding RamMb, StringFormat={}{0:0} MiB}" Width="*"/>
                                        <DataGridTextColumn Header="E/S media" Binding="{Binding IoMbPerSecond, StringFormat={}{0:0.00} MiB/s, TargetNullValue=—}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Abrir Monitor de recursos" Style="{StaticResource SecondaryBtn}"
                                            Click="BtnOpenResourceMonitor_Click" Margin="12,0,0,0" Padding="10,5"/>
                                    <TextBlock Text="La E/S incluye archivos, red y dispositivos. Para ver solo el disco, abre la pestaña Disco del monitor de Windows."
                                               Foreground="{DynamicResource QuietBrush}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Content="Liberar RAM Ahora" Style="{StaticResource PrimaryBtn}" Padding="12,6" FontSize="12" Click="BtnPurgeRam_Click" Margin="0,0,8,0"/>
                                        <Button Content="Actualizar" Style="{StaticResource SecondaryBtn}" Padding="12,6" FontSize="12" Click="BtnRefreshProcs_Click"/>
                                    </WrapPanel>
                                    <StackPanel>
                                        <TextBlock Text="MEMORIA RAM POR PROCESO" Style="{StaticResource SectionKicker}"/>
                                        <TextBlock Text="Programas que más memoria RAM están gastando ahora" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl x:Name="LstTopProcesses">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource DangerBtn}" Tag="{Binding Pid}" Click="BtnKillProc_Click"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RamMb, StringFormat={}{0:0.0} MB}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"/>
                                                        <TextBlock Text="{Binding Pid, StringFormat=' (ID {0})'}" Foreground="{DynamicResource QuietBrush}" FontSize="11.5"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}" Margin="0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Actualizar Inicio" Style="{StaticResource SecondaryBtn}" Padding="12,6" FontSize="12" Click="BtnRefreshStartup_Click" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="PROGRAMAS DE INICIO DE WINDOWS" Style="{StaticResource SectionKicker}"/>
                                        <TextBlock Text="Desactiva los que no necesites para arrancar más rápido y con más RAM libre." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl x:Name="LstStartupApps">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled, Mode=OneWay}" Tag="{Binding}" Click="StartupToggle_Click" Margin="12,0,0,0"/>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                                                            <TextBlock Text="{Binding Scope, StringFormat='  [{0}]'}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Command}" FontSize="11" Foreground="{DynamicResource QuietBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PESTAÑA 3 -->
            <TabItem x:Name="TabNetwork" Header="Red y ratón" Tag="{StaticResource NetworkGlyph}" Style="{StaticResource NavigationTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,8">
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="AJUSTES DE RED Y PUERTOS" Style="{StaticResource SectionKicker}"/>
                                <TextBlock Text="Optimiza la respuesta TCP y evita recortes de energía en USB y gráfica." Style="{StaticResource SectionSubtitle}"/>

                                <Border x:Name="RowSwNagle" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwNagle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Ajuste de latencia TCP" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Ajusta los parámetros de Nagle y las confirmaciones TCP. Puedes medir el resultado abajo." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwUsbPcie" Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <CheckBox x:Name="SwUsbPcie" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Evitar Cortes de Energía en USB y Gráfica (Enchufado)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Impide que Windows ponga en reposo los puertos USB del ratón/teclado o reduzca energía a la gráfica." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <Border x:Name="RowSwMouseAccel" Style="{StaticResource SettingRow}" Margin="0">
                                    <DockPanel>
                                        <CheckBox x:Name="SwMouseAccel" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Checked="Switch_Changed" Unchecked="Switch_Changed" Margin="14,0,0,0"/>
                                        <StackPanel>
                                            <TextBlock Text="Desactivar Aceleración del Ratón (Respuesta 1:1 sin permiso extra)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Desactiva «Mejorar la precisión del puntero» en Windows (MouseSpeed = 0) para mantener un movimiento lineal y constante al apuntar." FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RowEthernet" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="LATENCIA EN ETHERNET" Style="{StaticResource SectionKicker}"/>
                                <TextBlock Text="Prueba un ajuste a la vez. Al cambiarlo, el adaptador puede desconectarse unos segundos." Style="{StaticResource SectionSubtitle}"/>
                                <Label Content="Adaptador Ethernet" Target="{Binding ElementName=CmbEthernetAdapter}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="BtnRefreshEthernet" DockPanel.Dock="Right" Content="Detectar" Style="{StaticResource SecondaryBtn}" Click="BtnRefreshEthernet_Click" Margin="10,0,0,0"/>
                                    <ComboBox x:Name="CmbEthernetAdapter" DisplayMemberPath="Label" MinHeight="32" SelectionChanged="CmbEthernetAdapter_SelectionChanged"/>
                                </DockPanel>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <Button x:Name="BtnEthernetModeration" DockPanel.Dock="Right" Content="Desactivar" IsEnabled="False" Style="{StaticResource SecondaryBtn}" Click="BtnEthernetOption_Click" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Cambiar moderación de interrupciones"/>
                                        <StackPanel>
                                            <TextBlock Text="Moderación de interrupciones" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtEthernetModeration" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource SettingRow}">
                                    <DockPanel>
                                        <Button x:Name="BtnEthernetEee" DockPanel.Dock="Right" Content="Desactivar" IsEnabled="False" Style="{StaticResource SecondaryBtn}" Click="BtnEthernetOption_Click" VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.Name="Cambiar Ethernet de bajo consumo"/>
                                        <StackPanel>
                                            <TextBlock Text="Ethernet de bajo consumo (EEE)" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtEthernetEee" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock x:Name="TxtEthernetStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RowPingTest" Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <TextBlock Text="LATENCIA Y ESTABILIDAD DE RED" Style="{StaticResource SectionKicker}"/>
                                <TextBlock Text="Mide tu puerta de enlace y dos destinos públicos. Guarda una referencia y vuelve a medir después de cambiar un ajuste o perfil." Style="{StaticResource SectionSubtitle}"/>
                                <Label Content="Servidor o dirección IP adicional (opcional)" Target="{Binding ElementName=TxtPingTarget}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,4"/>
                                <TextBox x:Name="TxtPingTarget" MaxLength="253" Padding="8,6" Margin="0,0,0,10"/>

                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnPingTest" Content="Medir ping" Style="{StaticResource PrimaryBtn}" Padding="14,7" FontSize="12" Click="BtnPingTest_Click" Margin="0,0,8,4"/>
                                    <Button x:Name="BtnSavePingReference" Content="Guardar como referencia" Style="{StaticResource SecondaryBtn}" Click="BtnSavePingReference_Click" IsEnabled="False" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtPingStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>

                                <ItemsControl x:Name="LstPingResults">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Summary}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Comparison}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Comparison}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Algunos equipos filtran ICMP. Un destino sin respuesta puede seguir accesible por otros protocolos." FontSize="11.5" Foreground="{DynamicResource QuietBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RowLoadedPing" Style="{StaticResource SectionCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="PING BAJO CARGA" Style="{StaticResource SectionKicker}"/>
                                <TextBlock Text="Compara el router y un mismo destino externo con la conexión libre, durante una descarga y durante una subida. Usa el servidor opcional de arriba o Cloudflare (1.1.1.1 para IPv4)."
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                <TextBlock Text="La prueba genera hasta 100 MB por sentido con Cloudflare. El p95 muestra el tiempo dentro del cual llegó el 95 % de las respuestas."
                                           FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button x:Name="BtnLoadedPing" Content="Medir bajo carga" Style="{StaticResource PrimaryBtn}" Click="BtnLoadedPing_Click" Margin="0,0,8,4"/>
                                    <Button x:Name="BtnCancelLoadedPing" Content="Cancelar" Style="{StaticResource SecondaryBtn}" Click="BtnCancelLoadedPing_Click" IsEnabled="False" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtLoadedPingStatus" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                                <ItemsControl x:Name="LstLoadedPing">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Transfer}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding Results}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- PESTAÑA 4 -->
            <TabItem Header="Historial" Tag="{StaticResource HistoryGlyph}" Style="{StaticResource NavigationTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,8">
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock x:Name="TxtBaselineDate" DockPanel.Dock="Right" Text="Guardado: --" FontSize="11.5" Foreground="{DynamicResource QuietBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="CONFIGURACIÓN INICIAL Y RESTAURACIÓN" Style="{StaticResource SectionKicker}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <StackPanel>
                                    <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                        <TextBlock x:Name="TxtOrigLine1" Text="Cargando..." FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                        <TextBlock x:Name="TxtOrigLine2" Text="" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                        <TextBlock x:Name="TxtOrigLine3" Text="" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}" Padding="12,9">
                                        <TextBlock x:Name="TxtOrigLine4" Text="" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}" Padding="12,9" Margin="0">
                                        <TextBlock x:Name="TxtOrigLine5" Text="" FontSize="12.5" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <WrapPanel Margin="0,14,0,6">
                                    <Button x:Name="BtnUndoChange" Content="Deshacer último cambio" Style="{StaticResource SecondaryBtn}" Click="BtnUndoChange_Click" Margin="0,0,8,4"/>
                                    <Button x:Name="BtnRestoreOriginal" Content="Restaurar mi configuración original" Style="{StaticResource SecondaryBtn}" Click="BtnRestoreOriginal_Click" Margin="0,0,8,4"/>
                                    <Button Content="Estado de los ajustes" Style="{StaticResource SecondaryBtn}" Click="BtnShowSettingStatus_Click" Margin="0,0,0,4"/>
                                </WrapPanel>
                                <TextBlock x:Name="TxtRestoreStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionCard}" Margin="0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="Borrar Lista" Style="{StaticResource SecondaryBtn}" Padding="12,5" FontSize="11.5" Click="BtnClearHistory_Click" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="HISTORIAL DE CAMBIOS" Style="{StaticResource SectionKicker}"/>
                                        <TextBlock Text="Pulsa «Ir a ese apartado →» para saltar directamente a cualquier ajuste." FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl x:Name="LstHistory">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SettingRow}" Padding="14,11" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Ir a ese apartado →" Style="{StaticResource LinkBtn}" Tag="{Binding}" Click="BtnGoToSection_Click" Margin="12,0,0,0" VerticalAlignment="Top"/>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Action}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                                                <TextBlock Text="{Binding Timestamp, StringFormat='  •  {0}'}" FontSize="11" Foreground="{DynamicResource QuietBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SectionName}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Explanation}" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ResultDelta}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    <Button Content="Ver ajustes de este perfil" Style="{StaticResource LinkBtn}" HorizontalAlignment="Left"
                                                            Tag="{Binding}" Click="BtnShowProfileReport_Click" Margin="0,8,0,0"
                                                            Visibility="{Binding HasProfileSettings, Converter={StaticResource BooleanToVisibility}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TabBenchmarks" Header="Pruebas A/B" Tag="{StaticResource CompareGlyph}" Style="{StaticResource NavigationTab}">
                <TabItem.Resources>
                    <Style x:Key="BenchmarkHeader" TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="Padding" Value="9,7"/>
                    </Style>
                    <Style x:Key="BenchmarkTable" TargetType="DataGrid">
                        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                        <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/>
                        <Setter Property="AlternatingRowBackground" Value="{DynamicResource RaisedBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="ColumnHeaderStyle" Value="{StaticResource BenchmarkHeader}"/>
                        <Setter Property="GridLinesVisibility" Value="None"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="RowHeight" Value="27"/>
                    </Style>
                </TabItem.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,8">
                        <Border Style="{StaticResource SectionCard}">
                            <DockPanel>
                                <Button x:Name="BtnCancelBenchmark" DockPanel.Dock="Right" Content="Cancelar medición" Style="{StaticResource SecondaryBtn}" Click="BtnCancelBenchmark_Click" IsEnabled="False" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <StackPanel>
                                    <CheckBox x:Name="SwPauseAutomationForTests" Content="Pausar los cambios automáticos de perfil" Foreground="{DynamicResource TextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,5" Checked="BenchmarkPause_Changed" Unchecked="BenchmarkPause_Changed"/>
                                    <TextBlock x:Name="TxtBenchmarkStatus" Text="Mide A, cambia de perfil y repite la misma sesión para medir B." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <StackPanel x:Name="BenchmarkInputs">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="PRUEBA EN JUEGOS" Style="{StaticResource SectionKicker}"/>
                                    <TextBlock Text="Comparación guiada por juego" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,10"/>

                                    <Label Content="Comparaciones guardadas" Target="{Binding ElementName=CmbSavedGameComparisons}"
                                           Foreground="{DynamicResource TextBrush}" Padding="0,0,0,4"/>
                                    <DockPanel Margin="0,0,0,10">
                                        <Button x:Name="BtnNewGameComparison" DockPanel.Dock="Right" Content="Nueva comparación"
                                                Style="{StaticResource SecondaryBtn}" Click="BtnNewGameComparison_Click" Margin="10,0,0,0"/>
                                        <ComboBox x:Name="CmbSavedGameComparisons" DisplayMemberPath="Label" SelectionChanged="SavedGameComparison_Changed"/>
                                    </DockPanel>

                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,10">
                                        <TextBlock x:Name="TxtGameBenchmarkGuide" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                    </Border>
                                    <TextBlock Text="Mantén los mismos gráficos, resolución, límite de FPS y fuente de energía en A y B. Al pulsar Medir tienes 5 segundos para volver al juego."
                                               Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <Border Style="{StaticResource SettingRow}" Margin="0,0,0,12">
                                        <WrapPanel VerticalAlignment="Center">
                                            <Button Content="Seleccionar PresentMon" Style="{StaticResource SecondaryBtn}" Click="BtnChoosePresentMon_Click" Margin="0,0,8,0"/>
                                            <Button Content="Descarga oficial" Style="{StaticResource LinkBtn}" Click="BtnPresentMonDownload_Click" Margin="0,0,12,0"/>
                                            <TextBlock x:Name="TxtPresentMonFile" Text="Consola PresentMon 2.x requerida" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <Label Content="Ventana del juego" Target="{Binding ElementName=CmbGameTarget}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,4"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Buscar ventanas" Style="{StaticResource SecondaryBtn}" Click="BtnRefreshGameTargets_Click" Margin="8,0,0,0"/>
                                                <ComboBox x:Name="CmbGameTarget" DisplayMemberPath="Label" MinHeight="32"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Label Content="Escena y ajustes" Target="{Binding ElementName=TxtGameScenario}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,4"/>
                                            <TextBox x:Name="TxtGameScenario" MaxLength="180" Padding="8,6"/>
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                        <Label Content="Duración (s)" Target="{Binding ElementName=CmbGameDuration}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbGameDuration" Width="78" Margin="4,0,12,0"/>
                                        <Button x:Name="BtnGamePassA" Content="Medir A" Tag="A" Style="{StaticResource PrimaryBtn}" Click="BtnGameCapture_Click" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnGamePassB" Content="Medir B" Tag="B" Style="{StaticResource SecondaryBtn}" Click="BtnGameCapture_Click"/>
                                    </WrapPanel>

                                    <TextBlock x:Name="TxtGameBenchmarkSummary" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <DataGrid x:Name="GridGameBenchmark" Style="{StaticResource BenchmarkTable}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserSortColumns="False" Margin="0,0,0,8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Métrica" Binding="{Binding Metric}" Width="2*"/>
                                            <DataGridTextColumn Header="A · Referencia" Binding="{Binding A}" Width="*"/>
                                            <DataGridTextColumn Header="B · Comparación" Binding="{Binding B}" Width="*"/>
                                            <DataGridTextColumn Header="B − A" Binding="{Binding Delta}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="TxtGameTemperatureSource" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="FPS de fotogramas presentados. El 1 % low usa el promedio de los tiempos del 1 % de fotogramas más lentos." FontSize="11.5" Foreground="{DynamicResource QuietBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="BatteryBenchmarkCard" Style="{StaticResource SectionCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="AUTONOMÍA Y CONSUMO" Style="{StaticResource SectionKicker}"/>
                                    <TextBlock Text="Consumo en batería" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,4"/>
                                    <TextBlock Text="Desenchufa el cargador y repite la misma tarea con el mismo brillo y una carga inicial parecida. Para comparar Chill, actívalo antes de medir B." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <Label Content="Tarea de la sesión" Target="{Binding ElementName=TxtBatteryScenario}" Foreground="{DynamicResource TextBrush}" Padding="0,0,0,4"/>
                                    <TextBox x:Name="TxtBatteryScenario" MaxLength="180" Padding="8,6" Margin="0,0,0,12"/>
                                    <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                                        <Label Content="Minutos" Target="{Binding ElementName=CmbBatteryDuration}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="CmbBatteryDuration" Width="78" Margin="4,0,12,0"/>
                                        <Button Content="Medir A" Tag="A" Style="{StaticResource PrimaryBtn}" Click="BtnBatteryCapture_Click" Margin="0,0,8,0"/>
                                        <Button Content="Medir B" Tag="B" Style="{StaticResource SecondaryBtn}" Click="BtnBatteryCapture_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtBatteryBenchmarkSummary" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <DataGrid x:Name="GridBatteryBenchmark" Style="{StaticResource BenchmarkTable}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" CanUserSortColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Métrica" Binding="{Binding Metric}" Width="2*"/>
                                            <DataGridTextColumn Header="A" Binding="{Binding A}" Width="*"/>
                                            <DataGridTextColumn Header="B" Binding="{Binding B}" Width="*"/>
                                            <DataGridTextColumn Header="B − A" Binding="{Binding Delta}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <GridSplitter x:Name="ActivityLogSplitter" Grid.Row="2" Grid.Column="1" Visibility="Collapsed"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                      ToolTip="Arrastra para cambiar el ancho del registro" AutomationProperties.Name="Cambiar el ancho del registro"
                      DragCompleted="ActivityLogSplitter_DragCompleted" KeyUp="ActivityLogSplitter_KeyUp">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}">
                        <Border Width="2" CornerRadius="1" Margin="0,9" Background="{DynamicResource StrokeBrush}"
                                HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <Border x:Name="ActivityLogPanel" Grid.Row="2" Grid.Column="2" Panel.ZIndex="2" Visibility="Collapsed"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                CornerRadius="12" Padding="12,10" PreviewKeyDown="ActivityLogPanel_PreviewKeyDown">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource SecondaryBtn}" Click="BtnToggleActivityLog_Click"
                                Padding="9,4" Margin="8,0,0,0" AutomationProperties.Name="Cerrar registro de actividad"/>
                        <TextBlock Text="Registro de actividad" FontFamily="{DynamicResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <TextBox x:Name="TxtLog" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource MonoFont}" FontSize="13.5"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap"
                         AutomationProperties.Name="Registro de actividad"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
