<Window x:Class="WinPulseOptimizer.InstallationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/WinPulse.ico" Width="465" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource DisplayFont}" FontSize="14">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Description" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedBrush}" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                   Text="Windows te pedirá permiso de administrador para guardar los archivos en Archivos de programa." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryBtn}" />
            <Button x:Name="Confirm" Margin="8,0,0,0" Style="{StaticResource PrimaryBtn}" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
