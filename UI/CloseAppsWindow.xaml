<Window x:Class="WinPulseOptimizer.CloseAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cerrar apps para liberar RAM" Icon="/WinPulseOptimizer;component/Assets/WinPulse.ico"
        Width="660" Height="520" MinWidth="500" MinHeight="380"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource DisplayFont}">
    <DockPanel Margin="22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="LIBERAR RAM SIN TOCAR JUEGOS NI SHADERS" Style="{StaticResource SectionKicker}" Margin="0,0,0,4"/>
            <TextBlock Text="Elige las apps abiertas que quieres cerrar antes de jugar" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Solo cierra los programas que marques aquí (sin borrar cachés de shaders ni tocar juegos, drivers, Discord, OBS, Steam ni tu lista de excluidos)."
                       FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
            <WrapPanel>
                <Button Content="Solo minimizadas" Style="{StaticResource SecondaryBtn}" Padding="10,5" FontSize="12" Margin="0,0,8,0" Click="BtnSelectMinimized_Click"/>
                <Button Content="Seleccionar todo" Style="{StaticResource SecondaryBtn}" Padding="10,5" FontSize="12" Margin="0,0,8,0" Click="BtnSelectAll_Click"/>
                <Button Content="Desmarcar todo" Style="{StaticResource SecondaryBtn}" Padding="10,5" FontSize="12" Click="BtnSelectNone_Click"/>
            </WrapPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                <Button x:Name="BtnConfirmClose" Content="Cerrar seleccionadas" IsDefault="True"
                        Style="{StaticResource PrimaryBtn}" Click="BtnConfirmClose_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TxtSelectionSummary" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <Border Background="{DynamicResource StageBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LstCloseableApps">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource RowBrush}" BorderBrush="{DynamicResource RowStrokeBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding RamLabel}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                              Checked="ItemSelection_Changed" Unchecked="ItemSelection_Changed" Margin="0,0,10,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding StateLabel}" FontSize="11.5"
                                                       Foreground="{DynamicResource QuietBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProcessDetail}" FontSize="11"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
