<Window x:Class="WinPulseOptimizer.SettingStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estado de los ajustes" Icon="/WinPulseOptimizer;component/Assets/WinPulse.ico" Width="920" Height="610" MinWidth="640" MinHeight="390"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="ValueCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TxtStatusProfile" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,8">
                <ComboBox x:Name="CmbStatusFilter" Width="190" AutomationProperties.Name="Filtrar por estado"
                          DisplayMemberPath="Label" SelectionChanged="StatusFilter_Changed" Margin="0,0,8,0"/>
                <Button x:Name="BtnRefreshStatus" Content="Volver a comprobar" Style="{StaticResource SecondaryBtn}" Click="RefreshStatus_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TxtStatusSummary" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource SecondaryBtn}" Click="CloseStatus_Click" Margin="12,0,0,0"/>
            <TextBlock Text="Solicitado muestra el último valor pedido por WinPulse. Verificado indica que coincide con la lectura de Windows."
                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <DataGrid x:Name="GridSettingsStatus" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" Background="{DynamicResource PanelBrush}" RowBackground="{DynamicResource PanelBrush}"
                  AlternatingRowBackground="{DynamicResource RaisedBrush}" Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource StrokeBrush}" FontSize="13">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Padding" Value="8"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="PendingRestart">
                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Blocked">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ajuste" Binding="{Binding Name}" Width="1.4*" ElementStyle="{StaticResource ValueCell}"/>
                <DataGridTextColumn Header="Solicitado" Binding="{Binding Requested}" Width="*" ElementStyle="{StaticResource ValueCell}"/>
                <DataGridTextColumn Header="Valor de Windows" Binding="{Binding Actual}" Width="1.1*" ElementStyle="{StaticResource ValueCell}"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="1.1*" ElementStyle="{StaticResource ValueCell}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
