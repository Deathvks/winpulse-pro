<Window x:Class="WinPulseOptimizer.GameProfileImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importar perfiles por juego" Icon="/WinPulseOptimizer;component/Assets/WinPulse.ico" Width="720" Height="450" MinWidth="520" MinHeight="350"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="WrappedCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="TxtFileName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <CheckBox x:Name="SwReplaceNames" Content="Reemplazar perfiles locales con el mismo nombre"
                      Foreground="{DynamicResource TextBrush}" Margin="0,10,0,0" Checked="ReplaceNames_Changed" Unchecked="ReplaceNames_Changed"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                <Button x:Name="BtnConfirmImport" Content="Importar perfiles" IsDefault="True" IsEnabled="False"
                        Style="{StaticResource PrimaryBtn}" Click="ConfirmImport_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TxtImportSummary" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
        <DataGrid x:Name="GridImport" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" Background="{DynamicResource PanelBrush}" RowBackground="{DynamicResource PanelBrush}"
                  AlternatingRowBackground="{DynamicResource RaisedBrush}" Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource StrokeBrush}" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource StrokeBrush}" FontSize="13">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Padding" Value="8"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Perfil" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource WrappedCell}"/>
                <DataGridTextColumn Header="Ejecutables" Binding="{Binding Executables}" Width="1.3*" ElementStyle="{StaticResource WrappedCell}"/>
                <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="1.6*" ElementStyle="{StaticResource WrappedCell}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
