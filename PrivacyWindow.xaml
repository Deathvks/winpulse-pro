<Window x:Class="WinPulseOptimizer.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacidad de WinPulse" Icon="Assets/WinPulse.ico" Width="580" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <StackPanel Margin="24">
        <TextBlock Text="Estadísticas de uso" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                   Text="Si aceptas, WinPulse contará qué perfiles intentas aplicar, el resultado de los cambios de Windows y cuántas veces actúa el ajuste adaptativo de memoria. Sirve para saber qué funciones se usan y detectar fallos."/>
        <TextBlock x:Name="UsageDestination" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                   Text="El resumen se guarda en este equipo. Tú decides si lo exportas y con quién lo compartes. Incluye la versión de WinPulse y recuentos agregados. Los nombres de juegos, las rutas y el historial detallado quedan fuera del resumen."/>
        <TextBlock x:Name="UsageWithdrawal" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"
                   Text="Puedes seguir usando WinPulse con cualquier elección. Los recuentos se reinician al actualizar. En Privacidad puedes desactivar la recopilación y borrar el resumen local. Las copias exportadas las gestionas tú."/>
        <Button x:Name="BtnUsagePolicy" Content="Política de privacidad" Visibility="Collapsed"
                HorizontalAlignment="Left" Style="{StaticResource LinkBtn}" Margin="0,6,0,0" Click="OpenPolicy_Click"/>
        <TextBlock x:Name="PrivacyStatus" Margin="0,12,0,0" TextWrapping="Wrap" FontWeight="SemiBold"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBox x:Name="UsagePreview" IsReadOnly="True" Visibility="Collapsed" Margin="0,8,0,0" Padding="8"
                 MaxHeight="135" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Vista previa del resumen de uso"/>
        <Button x:Name="BtnExportUsage" Content="Exportar resumen" Visibility="Collapsed"
                Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ExportUsage_Click"/>
        <UniformGrid Columns="2" Margin="0,16,0,0">
            <Button x:Name="BtnDeclineUsage" Content="Rechazar" Style="{StaticResource SecondaryBtn}"
                    Margin="0,0,4,0" Click="DeclineUsage_Click"/>
            <Button x:Name="BtnAcceptUsage" Content="Aceptar" Style="{StaticResource SecondaryBtn}"
                    Margin="4,0,0,0" Click="AcceptUsage_Click"/>
        </UniformGrid>
    </StackPanel>
</Window>
