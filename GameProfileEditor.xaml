<Window x:Class="WinPulseOptimizer.GameProfileEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil por juego" Icon="Assets/WinPulse.ico" Width="720" Height="630" MinWidth="560" MinHeight="430"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" IsCancel="True" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                <Button Content="Guardar perfil" IsDefault="True" Style="{StaticResource PrimaryBtn}" Click="BtnSave_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtValidation" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Label Content="Nombre del perfil" Target="{Binding ElementName=TxtName}" Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="TxtName" MaxLength="48" Padding="6" Margin="0,0,0,8"/>
                <Label Content="Plan de energía base" Target="{Binding ElementName=CmbPowerBase}" Foreground="{DynamicResource TextBrush}"/>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Cargar ajustes del plan base" Click="BtnLoadDefaults_Click"
                            Style="{StaticResource SecondaryBtn}" Padding="10,5" Margin="8,0,0,0"/>
                    <ComboBox x:Name="CmbPowerBase" DisplayMemberPath="Label" MinHeight="28"/>
                </DockPanel>
                <TextBlock Text="El plan base define los límites de CPU, el turbo y el modo de energía. Puedes ajustar las demás opciones abajo."
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Label Content="Ejecutables asignados" Target="{Binding ElementName=TxtExecutables}" Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="TxtExecutables" AcceptsReturn="True" MaxLength="4000" VerticalScrollBarVisibility="Auto"
                         Height="77" Padding="6"/>
                <DockPanel Margin="0,5,0,12">
                    <Button DockPanel.Dock="Right" Content="Añadir .exe…" Click="BtnBrowse_Click" Style="{StaticResource SecondaryBtn}" Padding="10,5" Margin="8,0,0,0"/>
                    <TextBlock Text="Un nombre de archivo por línea, por ejemplo cs2.exe."
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="Ajustes del perfil" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ItemsControl x:Name="LstAdjustments">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center" Margin="0,4,8,4">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
